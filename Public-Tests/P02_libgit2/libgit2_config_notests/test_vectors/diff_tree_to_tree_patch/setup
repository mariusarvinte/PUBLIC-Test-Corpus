#!/bin/sh

# © 2026 Massachusetts Institute of Technology
# MIT License

set -e

rm -rf "${DEFAULT_RUN_DIR}/repo"
git init -b main "${DEFAULT_RUN_DIR}/repo" >/dev/null 2>&1
git -C "${DEFAULT_RUN_DIR}/repo" config gc.auto 0
git -C "${DEFAULT_RUN_DIR}/repo" config maintenance.auto false

printf '%s\n' 'start' > "${DEFAULT_RUN_DIR}/repo/file.txt"
git -C "${DEFAULT_RUN_DIR}/repo" add file.txt >/dev/null 2>&1

GIT_AUTHOR_NAME='Nora Vale' \
GIT_AUTHOR_EMAIL='nora@vale.org' \
GIT_COMMITTER_NAME='Nora Vale' \
GIT_COMMITTER_EMAIL='nora@vale.org' \
GIT_AUTHOR_DATE='2023-12-03T04:05:06Z' \
GIT_COMMITTER_DATE='2023-12-03T04:05:06Z' \
	git -C "${DEFAULT_RUN_DIR}/repo" commit -m first --no-gpg-sign >/dev/null 2>&1

printf '%s\n' 'start' 'more' > "${DEFAULT_RUN_DIR}/repo/file.txt"
git -C "${DEFAULT_RUN_DIR}/repo" add file.txt >/dev/null 2>&1

GIT_AUTHOR_NAME='Nora Vale' \
GIT_AUTHOR_EMAIL='nora@vale.org' \
GIT_COMMITTER_NAME='Nora Vale' \
GIT_COMMITTER_EMAIL='nora@vale.org' \
GIT_AUTHOR_DATE='2023-12-04T05:06:07Z' \
GIT_COMMITTER_DATE='2023-12-04T05:06:07Z' \
	git -C "${DEFAULT_RUN_DIR}/repo" commit -m second --no-gpg-sign >/dev/null 2>&1

printf '%s\n' "${DEFAULT_RUN_DIR}/repo" > "${WORKING_DIR_FILE}"
