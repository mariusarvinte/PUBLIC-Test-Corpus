#!/bin/sh

# © 2026 Massachusetts Institute of Technology
# MIT License

set -e

rm -rf "${DEFAULT_RUN_DIR}/repo"
git init -b main "${DEFAULT_RUN_DIR}/repo" >/dev/null 2>&1
git -C "${DEFAULT_RUN_DIR}/repo" config gc.auto 0
git -C "${DEFAULT_RUN_DIR}/repo" config maintenance.auto false
mkdir -p "${DEFAULT_RUN_DIR}/repo/src" "${DEFAULT_RUN_DIR}/repo/docs"

printf '%s\n' 'alpha' > "${DEFAULT_RUN_DIR}/repo/src/a.txt"
printf '%s\n' 'beta' > "${DEFAULT_RUN_DIR}/repo/src/b.txt"
printf '%s\n' 'readme' > "${DEFAULT_RUN_DIR}/repo/docs/readme.md"
git -C "${DEFAULT_RUN_DIR}/repo" add src/a.txt src/b.txt docs/readme.md >/dev/null 2>&1

printf '%s\n' "${DEFAULT_RUN_DIR}/repo" > "${WORKING_DIR_FILE}"
