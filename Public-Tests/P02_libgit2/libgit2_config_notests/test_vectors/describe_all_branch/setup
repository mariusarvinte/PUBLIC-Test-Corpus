#!/bin/sh

# © 2026 Massachusetts Institute of Technology
# MIT License

set -e

rm -rf "${DEFAULT_RUN_DIR}/repo"
git init -b main "${DEFAULT_RUN_DIR}/repo" >/dev/null 2>&1
git -C "${DEFAULT_RUN_DIR}/repo" config gc.auto 0
git -C "${DEFAULT_RUN_DIR}/repo" config maintenance.auto false

printf '%s\n' 'solo' > "${DEFAULT_RUN_DIR}/repo/solo.txt"
git -C "${DEFAULT_RUN_DIR}/repo" add solo.txt >/dev/null 2>&1

GIT_AUTHOR_NAME='Dane Fox' \
GIT_AUTHOR_EMAIL='dane@fox.org' \
GIT_COMMITTER_NAME='Dane Fox' \
GIT_COMMITTER_EMAIL='dane@fox.org' \
GIT_AUTHOR_DATE='2024-04-05T06:07:08Z' \
GIT_COMMITTER_DATE='2024-04-05T06:07:08Z' \
	git -C "${DEFAULT_RUN_DIR}/repo" commit -m solo --no-gpg-sign >/dev/null 2>&1

printf '%s\n' "${DEFAULT_RUN_DIR}/repo" > "${WORKING_DIR_FILE}"
