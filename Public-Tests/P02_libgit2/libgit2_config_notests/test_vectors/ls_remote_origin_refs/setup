#!/bin/sh

# © 2026 Massachusetts Institute of Technology
# MIT License

set -e

rm -rf "${DEFAULT_RUN_DIR}/remote.git" "${DEFAULT_RUN_DIR}/src" "${DEFAULT_RUN_DIR}/client"
git init --bare "${DEFAULT_RUN_DIR}/remote.git" >/dev/null 2>&1
git -C "${DEFAULT_RUN_DIR}/remote.git" config gc.auto 0
git -C "${DEFAULT_RUN_DIR}/remote.git" config maintenance.auto false
git init -b main "${DEFAULT_RUN_DIR}/src" >/dev/null 2>&1
git -C "${DEFAULT_RUN_DIR}/src" config gc.auto 0
git -C "${DEFAULT_RUN_DIR}/src" config maintenance.auto false

printf '%s\n' 'alpha' > "${DEFAULT_RUN_DIR}/src/file.txt"
git -C "${DEFAULT_RUN_DIR}/src" add file.txt >/dev/null 2>&1
GIT_AUTHOR_NAME='Nia Vale' \
GIT_AUTHOR_EMAIL='nia@cedar.dev' \
GIT_COMMITTER_NAME='Nia Vale' \
GIT_COMMITTER_EMAIL='nia@cedar.dev' \
GIT_AUTHOR_DATE='2024-01-02T03:04:05Z' \
GIT_COMMITTER_DATE='2024-01-02T03:04:05Z' \
	git -C "${DEFAULT_RUN_DIR}/src" commit -m base --no-gpg-sign >/dev/null 2>&1
git -C "${DEFAULT_RUN_DIR}/src" branch side >/dev/null 2>&1
GIT_COMMITTER_NAME='Nia Vale' \
GIT_COMMITTER_EMAIL='nia@cedar.dev' \
GIT_COMMITTER_DATE='2024-01-02T03:05:06Z' \
	git -C "${DEFAULT_RUN_DIR}/src" tag -a v1.0 -m v1.0 >/dev/null 2>&1
git -C "${DEFAULT_RUN_DIR}/src" remote add origin "../remote.git"
git -C "${DEFAULT_RUN_DIR}/src" push origin main side --tags >/dev/null 2>&1
git init -b main "${DEFAULT_RUN_DIR}/client" >/dev/null 2>&1
git -C "${DEFAULT_RUN_DIR}/client" config gc.auto 0
git -C "${DEFAULT_RUN_DIR}/client" config maintenance.auto false
git -C "${DEFAULT_RUN_DIR}/client" remote add origin "../remote.git"

printf '%s\n' "${DEFAULT_RUN_DIR}/client" > "${WORKING_DIR_FILE}"
