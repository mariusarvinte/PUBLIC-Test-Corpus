{
  "argv": [
    "clone",
    "/tmp/clone_existing_empty_source",
    "/tmp/clone_existing_empty_target"
  ],
  "env": {
    "GIT_AUTHOR_NAME": "Mira Lane",
    "GIT_AUTHOR_EMAIL": "mira@lane.test",
    "GIT_COMMITTER_NAME": "Mira Lane",
    "GIT_COMMITTER_EMAIL": "mira@lane.test",
    "GIT_AUTHOR_DATE": "2024-04-05T06:07:08Z",
    "GIT_COMMITTER_DATE": "2024-04-05T06:07:08Z",
    "FAKETIME": "2024-04-05 09:10:11",
