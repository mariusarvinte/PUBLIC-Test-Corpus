#!/bin/sh

# © 2026 Massachusetts Institute of Technology
# MIT License

set -e

rm -rf "${DEFAULT_RUN_DIR}/repo"
git init -b main "${DEFAULT_RUN_DIR}/repo" >/dev/null 2>&1
git -C "${DEFAULT_RUN_DIR}/repo" config gc.auto 0
git -C "${DEFAULT_RUN_DIR}/repo" config maintenance.auto false

printf '%s\n' 'seed' > "${DEFAULT_RUN_DIR}/repo/file.txt"
git -C "${DEFAULT_RUN_DIR}/repo" add file.txt >/dev/null 2>&1

GIT_AUTHOR_NAME='Ivo Reed' \
GIT_AUTHOR_EMAIL='ivo@reed.net' \
GIT_COMMITTER_NAME='Ivo Reed' \
GIT_COMMITTER_EMAIL='ivo@reed.net' \
GIT_AUTHOR_DATE='2022-02-03T04:05:06Z' \
GIT_COMMITTER_DATE='2022-02-03T04:05:06Z' \
	git -C "${DEFAULT_RUN_DIR}/repo" commit -m seed --no-gpg-sign >/dev/null 2>&1

git -C "${DEFAULT_RUN_DIR}/repo" branch side >/dev/null 2>&1

printf '%s\n' "${DEFAULT_RUN_DIR}/repo" > "${WORKING_DIR_FILE}"
