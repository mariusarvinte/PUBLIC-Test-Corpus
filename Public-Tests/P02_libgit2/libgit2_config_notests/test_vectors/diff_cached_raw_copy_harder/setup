#!/bin/sh

# © 2026 Massachusetts Institute of Technology
# MIT License

set -e

rm -rf "${DEFAULT_RUN_DIR}/repo"
git init -b main "${DEFAULT_RUN_DIR}/repo" >/dev/null 2>&1
git -C "${DEFAULT_RUN_DIR}/repo" config gc.auto 0
git -C "${DEFAULT_RUN_DIR}/repo" config maintenance.auto false

printf '%s\n' 'base' > "${DEFAULT_RUN_DIR}/repo/original.txt"
git -C "${DEFAULT_RUN_DIR}/repo" add original.txt >/dev/null 2>&1

GIT_AUTHOR_NAME='Oren Pike' \
GIT_AUTHOR_EMAIL='oren@pike.io' \
GIT_COMMITTER_NAME='Oren Pike' \
GIT_COMMITTER_EMAIL='oren@pike.io' \
GIT_AUTHOR_DATE='2024-01-04T05:06:07Z' \
GIT_COMMITTER_DATE='2024-01-04T05:06:07Z' \
	git -C "${DEFAULT_RUN_DIR}/repo" commit -m base --no-gpg-sign >/dev/null 2>&1

cp "${DEFAULT_RUN_DIR}/repo/original.txt" "${DEFAULT_RUN_DIR}/repo/copied.txt"
git -C "${DEFAULT_RUN_DIR}/repo" add copied.txt >/dev/null 2>&1

printf '%s\n' "${DEFAULT_RUN_DIR}/repo" > "${WORKING_DIR_FILE}"
