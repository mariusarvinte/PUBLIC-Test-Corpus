#!/bin/sh

# © 2026 Massachusetts Institute of Technology
# MIT License

set -e

rm -rf /tmp/clone_no_checkout_source
git init -b main /tmp/clone_no_checkout_source >/dev/null 2>&1

printf '%s\n' 'hello' > /tmp/clone_no_checkout_source/readme.txt
git -C /tmp/clone_no_checkout_source add readme.txt >/dev/null 2>&1

GIT_AUTHOR_NAME='Nora Vale' \
GIT_AUTHOR_EMAIL='nora@cedar.org' \
GIT_COMMITTER_NAME='Nora Vale' \
GIT_COMMITTER_EMAIL='nora@cedar.org' \
GIT_AUTHOR_DATE='2022-02-02T02:02:02Z' \
GIT_COMMITTER_DATE='2022-02-02T02:02:02Z' \
	git -C /tmp/clone_no_checkout_source commit -m init --no-gpg-sign >/dev/null 2>&1
