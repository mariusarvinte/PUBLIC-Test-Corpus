#!/bin/sh

# © 2026 Massachusetts Institute of Technology
# MIT License

set -e

rm -rf "${DEFAULT_RUN_DIR}/repo"
git init -b main "${DEFAULT_RUN_DIR}/repo" >/dev/null 2>&1
git -C "${DEFAULT_RUN_DIR}/repo" config gc.auto 0
git -C "${DEFAULT_RUN_DIR}/repo" config maintenance.auto false

printf '%s\n' 'one' > "${DEFAULT_RUN_DIR}/repo/keep.txt"
printf '%s\n' 'red' > "${DEFAULT_RUN_DIR}/repo/only.txt"
git -C "${DEFAULT_RUN_DIR}/repo" add keep.txt only.txt >/dev/null 2>&1

GIT_AUTHOR_NAME='Lena Hart' \
GIT_AUTHOR_EMAIL='lena@hart.dev' \
GIT_COMMITTER_NAME='Lena Hart' \
GIT_COMMITTER_EMAIL='lena@hart.dev' \
GIT_AUTHOR_DATE='2021-10-01T01:02:03Z' \
GIT_COMMITTER_DATE='2021-10-01T01:02:03Z' \
	git -C "${DEFAULT_RUN_DIR}/repo" commit -m base --no-gpg-sign >/dev/null 2>&1

printf '%s\n' 'one changed' > "${DEFAULT_RUN_DIR}/repo/keep.txt"
printf '%s\n' 'blue' > "${DEFAULT_RUN_DIR}/repo/only.txt"

printf '%s\n' "${DEFAULT_RUN_DIR}/repo" > "${WORKING_DIR_FILE}"
