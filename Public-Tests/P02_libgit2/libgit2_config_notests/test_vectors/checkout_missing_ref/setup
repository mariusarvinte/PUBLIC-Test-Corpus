#!/bin/sh

# © 2026 Massachusetts Institute of Technology
# MIT License

set -e

rm -rf "${DEFAULT_RUN_DIR}/repo"
rm -rf "${DEFAULT_RUN_DIR}/home"
mkdir -p "${DEFAULT_RUN_DIR}/home"
git init -b main "${DEFAULT_RUN_DIR}/repo" >/dev/null 2>&1
git -C "${DEFAULT_RUN_DIR}/repo" config gc.auto 0
git -C "${DEFAULT_RUN_DIR}/repo" config maintenance.auto false

touch "${DEFAULT_RUN_DIR}/home/.gitconfig"

printf '%s\n' 'seed' > "${DEFAULT_RUN_DIR}/repo/story.txt"
git -C "${DEFAULT_RUN_DIR}/repo" add story.txt >/dev/null 2>&1

GIT_AUTHOR_NAME='Ezra Bloom' \
GIT_AUTHOR_EMAIL='ezra@willow.app' \
GIT_COMMITTER_NAME='Ezra Bloom' \
GIT_COMMITTER_EMAIL='ezra@willow.app' \
GIT_AUTHOR_DATE='2026-08-12T16:05:39Z' \
GIT_COMMITTER_DATE='2026-08-12T16:05:39Z' \
	git -C "${DEFAULT_RUN_DIR}/repo" commit -m seed --no-gpg-sign >/dev/null 2>&1

printf '%s\n' "${DEFAULT_RUN_DIR}/repo" > "${WORKING_DIR_FILE}"
