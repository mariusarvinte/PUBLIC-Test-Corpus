#!/bin/sh

# © 2026 Massachusetts Institute of Technology
# MIT License

set -e

rm -rf /tmp/clone_branch_quiet_source
git init -b main /tmp/clone_branch_quiet_source >/dev/null 2>&1

printf '%s\n' 'main' > /tmp/clone_branch_quiet_source/readme.txt
git -C /tmp/clone_branch_quiet_source add readme.txt >/dev/null 2>&1

GIT_AUTHOR_NAME='Talia West' \
GIT_AUTHOR_EMAIL='talia@hearth.dev' \
GIT_COMMITTER_NAME='Talia West' \
GIT_COMMITTER_EMAIL='talia@hearth.dev' \
GIT_AUTHOR_DATE='2021-05-06T07:08:09Z' \
GIT_COMMITTER_DATE='2021-05-06T07:08:09Z' \
	git -C /tmp/clone_branch_quiet_source commit -m main --no-gpg-sign >/dev/null 2>&1

git -C /tmp/clone_branch_quiet_source checkout -b side >/dev/null 2>&1
printf '%s\n' 'side' > /tmp/clone_branch_quiet_source/readme.txt
git -C /tmp/clone_branch_quiet_source add readme.txt >/dev/null 2>&1

GIT_AUTHOR_NAME='Micah Stone' \
GIT_AUTHOR_EMAIL='micah@lantern.io' \
GIT_COMMITTER_NAME='Micah Stone' \
GIT_COMMITTER_EMAIL='micah@lantern.io' \
GIT_AUTHOR_DATE='2024-09-10T11:12:13Z' \
GIT_COMMITTER_DATE='2024-09-10T11:12:13Z' \
	git -C /tmp/clone_branch_quiet_source commit -m side --no-gpg-sign >/dev/null 2>&1

git -C /tmp/clone_branch_quiet_source checkout main >/dev/null 2>&1
