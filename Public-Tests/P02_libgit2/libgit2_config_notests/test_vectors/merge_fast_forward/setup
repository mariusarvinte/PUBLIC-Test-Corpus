set -e

rm -rf "${DEFAULT_RUN_DIR}/repo" "${DEFAULT_RUN_DIR}/merge-resolve"
tar --no-same-owner -C "${DEFAULT_RUN_DIR}" -xzf "${TEST_RESOURCES}/merge-resolve.tar.gz"
mv "${DEFAULT_RUN_DIR}/merge-resolve" "${DEFAULT_RUN_DIR}/repo"
mv "${DEFAULT_RUN_DIR}/repo/.gitted" "${DEFAULT_RUN_DIR}/repo/.git"
printf '%s\n' "${DEFAULT_RUN_DIR}/repo" > "${WORKING_DIR_FILE}"
