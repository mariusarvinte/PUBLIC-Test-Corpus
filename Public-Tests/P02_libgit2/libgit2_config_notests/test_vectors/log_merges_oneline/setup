#!/bin/sh

# © 2026 Massachusetts Institute of Technology
# MIT License

set -e

rm -rf "${DEFAULT_RUN_DIR}/repo"
git init -b main "${DEFAULT_RUN_DIR}/repo" >/dev/null 2>&1
git -C "${DEFAULT_RUN_DIR}/repo" config gc.auto 0
git -C "${DEFAULT_RUN_DIR}/repo" config maintenance.auto false

printf '%s\n' 'base' > "${DEFAULT_RUN_DIR}/repo/base.txt"
git -C "${DEFAULT_RUN_DIR}/repo" add base.txt >/dev/null 2>&1
GIT_AUTHOR_NAME='Ava North' \
GIT_AUTHOR_EMAIL='ava@north.dev' \
GIT_COMMITTER_NAME='Ava North' \
GIT_COMMITTER_EMAIL='ava@north.dev' \
GIT_AUTHOR_DATE='2024-01-10T10:00:00Z' \
GIT_COMMITTER_DATE='2024-01-10T10:00:00Z' \
	git -C "${DEFAULT_RUN_DIR}/repo" commit -m 'base story' --no-gpg-sign >/dev/null 2>&1

git -C "${DEFAULT_RUN_DIR}/repo" checkout -b side >/dev/null 2>&1
printf '%s\n' 'side' > "${DEFAULT_RUN_DIR}/repo/side.txt"
git -C "${DEFAULT_RUN_DIR}/repo" add side.txt >/dev/null 2>&1
GIT_AUTHOR_NAME='Beck Stone' \
GIT_AUTHOR_EMAIL='beck@stone.io' \
GIT_COMMITTER_NAME='Beck Stone' \
GIT_COMMITTER_EMAIL='beck@stone.io' \
GIT_AUTHOR_DATE='2024-01-12T09:00:00Z' \
GIT_COMMITTER_DATE='2024-01-12T09:00:00Z' \
	git -C "${DEFAULT_RUN_DIR}/repo" commit -m 'side change' --no-gpg-sign >/dev/null 2>&1

git -C "${DEFAULT_RUN_DIR}/repo" checkout main >/dev/null 2>&1
printf '%s\n' 'main' > "${DEFAULT_RUN_DIR}/repo/main.txt"
git -C "${DEFAULT_RUN_DIR}/repo" add main.txt >/dev/null 2>&1
GIT_AUTHOR_NAME='Cleo Hart' \
GIT_AUTHOR_EMAIL='cleo@harbor.io' \
GIT_COMMITTER_NAME='Cleo Hart' \
GIT_COMMITTER_EMAIL='cleo@harbor.io' \
GIT_AUTHOR_DATE='2024-01-11T09:00:00Z' \
GIT_COMMITTER_DATE='2024-01-11T09:00:00Z' \
	git -C "${DEFAULT_RUN_DIR}/repo" commit -m 'main change' --no-gpg-sign >/dev/null 2>&1

GIT_AUTHOR_NAME='Mira Lane' \
GIT_AUTHOR_EMAIL='mira@lane.dev' \
GIT_COMMITTER_NAME='Mira Lane' \
GIT_COMMITTER_EMAIL='mira@lane.dev' \
GIT_AUTHOR_DATE='2024-01-13T09:00:00Z' \
GIT_COMMITTER_DATE='2024-01-13T09:00:00Z' \
	git -C "${DEFAULT_RUN_DIR}/repo" merge side --no-ff -m 'merge side' >/dev/null 2>&1

printf '%s\n' "${DEFAULT_RUN_DIR}/repo" > "${WORKING_DIR_FILE}"
