set -e

rm -rf "${DEFAULT_RUN_DIR}/super" "${DEFAULT_RUN_DIR}/sub"
tar --no-same-owner -C "${DEFAULT_RUN_DIR}" -xzf "${TEST_RESOURCES}/repos.tar.gz"
mv "${DEFAULT_RUN_DIR}/super/.gitted" "${DEFAULT_RUN_DIR}/super/.git"
mv "${DEFAULT_RUN_DIR}/sub/.gitted" "${DEFAULT_RUN_DIR}/sub/.git"
printf '%s\n' "${DEFAULT_RUN_DIR}/super" > "${WORKING_DIR_FILE}"
