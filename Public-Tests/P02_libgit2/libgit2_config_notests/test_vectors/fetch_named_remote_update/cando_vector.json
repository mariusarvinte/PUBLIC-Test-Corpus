{
  "argv": [
    "fetch",
    "upstream"
  ],
  "env": {
    "GIT_AUTHOR_NAME": "Mina Vale",
    "GIT_AUTHOR_EMAIL": "mina@vale.test",
    "GIT_COMMITTER_NAME": "Mina Vale",
    "GIT_COMMITTER_EMAIL": "mina@vale.test",
    "TZ": "UTC",
    "FAKETIME": "2024-06-02 04:05:06",
    "FAKETIME_DONT_FAKE_MONOTONIC": "1",
    "FAKETIME_DISABLE_SHM": "1"
  },
  "stdout": {
    "pattern": "(?s)^Fetching upstream\r?\n.*?\\[updated\\] b8c1f83a19\\.\\.99374cfed3 refs/heads/main -> refs/remotes/upstream/main\r?\n?$",
    "is_regex": true
  }
}
