set -e

rm -rf "${DEFAULT_RUN_DIR}/repo" "${DEFAULT_RUN_DIR}/wt" "${DEFAULT_RUN_DIR}/other"
tar --no-same-owner -C "${DEFAULT_RUN_DIR}" -xzf "${TEST_RESOURCES}/repo.tar.gz"
mv "${DEFAULT_RUN_DIR}/repo/.gitted" "${DEFAULT_RUN_DIR}/repo/.git"
git -C "${DEFAULT_RUN_DIR}/repo" worktree add "${DEFAULT_RUN_DIR}/wt" topic >/dev/null 2>&1
printf '%s\n' "${DEFAULT_RUN_DIR}/repo" > "${WORKING_DIR_FILE}"
