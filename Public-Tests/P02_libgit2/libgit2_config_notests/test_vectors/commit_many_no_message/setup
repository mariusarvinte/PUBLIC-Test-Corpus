#!/bin/sh

# © 2026 Massachusetts Institute of Technology
# MIT License

set -e

rm -rf "${DEFAULT_RUN_DIR}/repo"
git init -b main "${DEFAULT_RUN_DIR}/repo" >/dev/null 2>&1
git -C "${DEFAULT_RUN_DIR}/repo" config gc.auto 0
git -C "${DEFAULT_RUN_DIR}/repo" config maintenance.auto false
git -C "${DEFAULT_RUN_DIR}/repo" config core.logAllRefUpdates false >/dev/null 2>&1

i=1
while [ "$i" -le 21 ]; do
  file_path=$(printf 'batch/file_%02d.txt' "$i")
  blob_oid=$(printf 'line %02d\n' "$i" | git -C "${DEFAULT_RUN_DIR}/repo" hash-object -w --stdin)
  git -C "${DEFAULT_RUN_DIR}/repo" update-index --add --cacheinfo 100644,"${blob_oid}","${file_path}"
  i=$((i + 1))
done

printf '%s\n' "${DEFAULT_RUN_DIR}/repo" > "${WORKING_DIR_FILE}"
