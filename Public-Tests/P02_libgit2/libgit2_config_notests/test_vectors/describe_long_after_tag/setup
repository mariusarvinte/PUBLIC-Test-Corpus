#!/bin/sh

# © 2026 Massachusetts Institute of Technology
# MIT License

set -e

rm -rf "${DEFAULT_RUN_DIR}/repo"
git init -b main "${DEFAULT_RUN_DIR}/repo" >/dev/null 2>&1
git -C "${DEFAULT_RUN_DIR}/repo" config gc.auto 0
git -C "${DEFAULT_RUN_DIR}/repo" config maintenance.auto false

printf '%s\n' 'base' > "${DEFAULT_RUN_DIR}/repo/story.txt"
git -C "${DEFAULT_RUN_DIR}/repo" add story.txt >/dev/null 2>&1

GIT_AUTHOR_NAME='Bea Lark' \
GIT_AUTHOR_EMAIL='bea@lark.net' \
GIT_COMMITTER_NAME='Bea Lark' \
GIT_COMMITTER_EMAIL='bea@lark.net' \
GIT_AUTHOR_DATE='2022-03-04T05:06:07Z' \
GIT_COMMITTER_DATE='2022-03-04T05:06:07Z' \
	git -C "${DEFAULT_RUN_DIR}/repo" commit -m base --no-gpg-sign >/dev/null 2>&1

GIT_COMMITTER_NAME='Bea Lark' \
GIT_COMMITTER_EMAIL='bea@lark.net' \
GIT_COMMITTER_DATE='2022-03-04T05:07:08Z' \
	git -C "${DEFAULT_RUN_DIR}/repo" tag -a v2.0.0 -m v2.0.0 >/dev/null 2>&1

printf '%s\n' 'base' 'next' > "${DEFAULT_RUN_DIR}/repo/story.txt"
git -C "${DEFAULT_RUN_DIR}/repo" add story.txt >/dev/null 2>&1

GIT_AUTHOR_NAME='Cleo Hart' \
GIT_AUTHOR_EMAIL='cleo@harbor.io' \
GIT_COMMITTER_NAME='Cleo Hart' \
GIT_COMMITTER_EMAIL='cleo@harbor.io' \
GIT_AUTHOR_DATE='2022-03-05T06:07:08Z' \
GIT_COMMITTER_DATE='2022-03-05T06:07:08Z' \
	git -C "${DEFAULT_RUN_DIR}/repo" commit -m next --no-gpg-sign >/dev/null 2>&1

printf '%s\n' "${DEFAULT_RUN_DIR}/repo" > "${WORKING_DIR_FILE}"
