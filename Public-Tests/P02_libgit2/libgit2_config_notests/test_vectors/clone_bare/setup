#!/bin/sh

# © 2026 Massachusetts Institute of Technology
# MIT License

set -e
export GIT_AUTHOR_DATE="2024-01-01T00:00:00Z",
export GIT_COMMITTER_DATE="2024-01-01T00:00:00Z",

rm -rf /tmp/p02_clone_bare_repo
git init -b main /tmp/p02_clone_bare_repo >/dev/null 2>&1
git -C /tmp/p02_clone_bare_repo config gc.auto 0
git -C /tmp/p02_clone_bare_repo config maintenance.auto false
git -C /tmp/p02_clone_bare_repo config user.email test@example.com
git -C /tmp/p02_clone_bare_repo config user.name tester
printf 'hello\n' > /tmp/p02_clone_bare_repo/README.md
git -C /tmp/p02_clone_bare_repo add README.md
git -C /tmp/p02_clone_bare_repo commit -m init >/dev/null 2>&1
