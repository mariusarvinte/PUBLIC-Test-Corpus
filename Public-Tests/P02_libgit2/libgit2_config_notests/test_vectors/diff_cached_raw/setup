#!/bin/sh

# © 2026 Massachusetts Institute of Technology
# MIT License

set -e

rm -rf "${DEFAULT_RUN_DIR}/repo"
git init -b main "${DEFAULT_RUN_DIR}/repo" >/dev/null 2>&1
git -C "${DEFAULT_RUN_DIR}/repo" config gc.auto 0
git -C "${DEFAULT_RUN_DIR}/repo" config maintenance.auto false

printf '%s\n' 'alpha' > "${DEFAULT_RUN_DIR}/repo/a.txt"
printf '%s\n' 'beta' > "${DEFAULT_RUN_DIR}/repo/b.txt"
git -C "${DEFAULT_RUN_DIR}/repo" add a.txt b.txt >/dev/null 2>&1

GIT_AUTHOR_NAME='Milo West' \
GIT_AUTHOR_EMAIL='milo@west.net' \
GIT_COMMITTER_NAME='Milo West' \
GIT_COMMITTER_EMAIL='milo@west.net' \
GIT_AUTHOR_DATE='2022-11-02T03:04:05Z' \
GIT_COMMITTER_DATE='2022-11-02T03:04:05Z' \
	git -C "${DEFAULT_RUN_DIR}/repo" commit -m base --no-gpg-sign >/dev/null 2>&1

printf '%s\n' 'alpha staged' > "${DEFAULT_RUN_DIR}/repo/a.txt"
printf '%s\n' 'beta staged' > "${DEFAULT_RUN_DIR}/repo/b.txt"
git -C "${DEFAULT_RUN_DIR}/repo" add a.txt b.txt >/dev/null 2>&1

printf '%s\n' "${DEFAULT_RUN_DIR}/repo" > "${WORKING_DIR_FILE}"
