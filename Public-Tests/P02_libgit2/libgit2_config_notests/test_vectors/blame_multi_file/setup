#!/bin/sh

# © 2026 Massachusetts Institute of Technology
# MIT License

set -e

rm -rf "${DEFAULT_RUN_DIR}/repo"
git init -b main "${DEFAULT_RUN_DIR}/repo" >/dev/null 2>&1
git -C "${DEFAULT_RUN_DIR}/repo" config gc.auto 0
git -C "${DEFAULT_RUN_DIR}/repo" config maintenance.auto false

repo="${DEFAULT_RUN_DIR}/repo"

do_commit() {
  msg="$1"; name="$2"; email="$3"; date="$4"; shift 4
  git -C "$repo" add -A >/dev/null 2>&1
  GIT_AUTHOR_NAME="$name" \
    GIT_AUTHOR_EMAIL="$email" \
    GIT_COMMITTER_NAME="$name" \
    GIT_COMMITTER_EMAIL="$email" \
    GIT_AUTHOR_DATE="$date" \
    GIT_COMMITTER_DATE="$date" \
    git -C "$repo" commit -m "$msg" --no-gpg-sign >/dev/null 2>&1
}

printf '%s\n' 'A1' > "$repo/file1.txt"
printf '%s\n' 'B1' > "$repo/file2.txt"
do_commit init Alice alice@alpha.org 2024-01-01T00:00:00Z

printf '%s\n' 'A2' > "$repo/file1.txt"
do_commit c1 Bob bob@beta.net 2024-01-02T00:00:00Z

printf '%s\n' 'B2' > "$repo/file2.txt"
do_commit c2 Carol carol@gamma.io 2024-01-03T00:00:00Z

printf '%s\n' 'A3' > "$repo/file1.txt"
do_commit c3 Dave dave@delta.dev 2024-01-04T00:00:00Z

printf '%s\n' 'B3' > "$repo/file2.txt"
do_commit c4 Eve eve@epsilon.com 2024-01-05T00:00:00Z

printf '%s\n' 'A4' > "$repo/file1.txt"
do_commit c5 Frank frank@zeta.org 2024-01-06T00:00:00Z

printf '%s\n' 'B4' > "$repo/file2.txt"
do_commit c6 Grace grace@eta.org 2024-01-07T00:00:00Z

printf '%s\n' 'A5' > "$repo/file1.txt"
do_commit c7 Heidi heidi@theta.net 2024-01-08T00:00:00Z

printf '%s\n' 'B5' > "$repo/file2.txt"
do_commit c8 Ivan ivan@iota.io 2024-01-09T00:00:00Z

printf '%s\n' 'A6' > "$repo/file1.txt"
do_commit c9 Judy judy@kappa.dev 2024-01-10T00:00:00Z

printf '%s\n' 'A7' > "$repo/file1.txt"
printf '%s\n' 'B7' > "$repo/file2.txt"
do_commit c10 Mallory mallory@lambda.org 2024-01-11T00:00:00Z

printf '%s\n' "$repo" > "${WORKING_DIR_FILE}"
