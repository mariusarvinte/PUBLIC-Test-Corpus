{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 19,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "build-ninja",
      "cacheVariables": {
        "CMAKE_C_STANDARD": "99",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "test",
      "inherits": "base",
      "cacheVariables": {
        "USE_COMPRESSION": "builtin",
        "USE_NSEC": "ON",
        "EXPERIMENTAL_SHA256": "OFF",
        "DEPRECATE_HARD": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "test",
      "configurePreset": "test"
    }
  ]
}
