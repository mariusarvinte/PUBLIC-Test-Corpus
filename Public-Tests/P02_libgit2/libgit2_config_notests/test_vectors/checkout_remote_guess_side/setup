#!/bin/sh

# © 2026 Massachusetts Institute of Technology
# MIT License

set -e

rm -rf "${DEFAULT_RUN_DIR}/origin" "${DEFAULT_RUN_DIR}/repo"
git init -b main "${DEFAULT_RUN_DIR}/origin" >/dev/null 2>&1
git -C "${DEFAULT_RUN_DIR}/origin" config gc.auto 0
git -C "${DEFAULT_RUN_DIR}/origin" config maintenance.auto false

printf '%s\n' 'base' > "${DEFAULT_RUN_DIR}/origin/file.txt"
git -C "${DEFAULT_RUN_DIR}/origin" add file.txt >/dev/null 2>&1

GIT_AUTHOR_NAME='A' \
GIT_AUTHOR_EMAIL='a@a' \
GIT_COMMITTER_NAME='A' \
GIT_COMMITTER_EMAIL='a@a' \
GIT_AUTHOR_DATE='2024-01-01T00:00:00Z' \
GIT_COMMITTER_DATE='2024-01-01T00:00:00Z' \
	git -C "${DEFAULT_RUN_DIR}/origin" commit -m c1 --no-gpg-sign >/dev/null 2>&1

git -C "${DEFAULT_RUN_DIR}/origin" checkout -b side >/dev/null 2>&1
printf '%s\n' 'side' > "${DEFAULT_RUN_DIR}/origin/file.txt"
git -C "${DEFAULT_RUN_DIR}/origin" add file.txt >/dev/null 2>&1

GIT_AUTHOR_NAME='A' \
GIT_AUTHOR_EMAIL='a@a' \
GIT_COMMITTER_NAME='A' \
GIT_COMMITTER_EMAIL='a@a' \
GIT_AUTHOR_DATE='2024-01-02T00:00:00Z' \
GIT_COMMITTER_DATE='2024-01-02T00:00:00Z' \
	git -C "${DEFAULT_RUN_DIR}/origin" commit -m c2 --no-gpg-sign >/dev/null 2>&1

git -C "${DEFAULT_RUN_DIR}/origin" checkout main >/dev/null 2>&1

git clone "${DEFAULT_RUN_DIR}/origin" "${DEFAULT_RUN_DIR}/repo" >/dev/null 2>&1
git -C "${DEFAULT_RUN_DIR}/repo" config gc.auto 0
git -C "${DEFAULT_RUN_DIR}/repo" config maintenance.auto false

rm -rf "${DEFAULT_RUN_DIR}/repo/.git/logs"

printf '%s\n' "${DEFAULT_RUN_DIR}/repo" > "${WORKING_DIR_FILE}"
