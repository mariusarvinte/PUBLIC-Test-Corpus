set -e

rm -f "${DEFAULT_RUN_DIR}/custom.cfg"
git config -f "${DEFAULT_RUN_DIR}/custom.cfg" user.email ivy@glade.io >/dev/null 2>&1
git config -f "${DEFAULT_RUN_DIR}/custom.cfg" core.pager less >/dev/null 2>&1

printf '%s\n' "${DEFAULT_RUN_DIR}" > "${WORKING_DIR_FILE}"
