#!/bin/sh

# © 2026 Massachusetts Institute of Technology
# MIT License

set -e

rm -rf "${DEFAULT_RUN_DIR}/repo"
git init -b main "${DEFAULT_RUN_DIR}/repo" >/dev/null 2>&1
git -C "${DEFAULT_RUN_DIR}/repo" config gc.auto 0
git -C "${DEFAULT_RUN_DIR}/repo" config maintenance.auto false
git -C "${DEFAULT_RUN_DIR}/repo" config core.logAllRefUpdates false >/dev/null 2>&1

base_blob_oid=$(printf '%s\n' 'base' | git -C "${DEFAULT_RUN_DIR}/repo" hash-object -w --stdin)
git -C "${DEFAULT_RUN_DIR}/repo" update-index --add --cacheinfo 100644,"${base_blob_oid}",story.txt

GIT_AUTHOR_NAME='Omar Pike' \
GIT_AUTHOR_EMAIL='omar@granite.io' \
GIT_COMMITTER_NAME='Omar Pike' \
GIT_COMMITTER_EMAIL='omar@granite.io' \
GIT_AUTHOR_DATE='2023-07-08T09:10:11Z' \
GIT_COMMITTER_DATE='2023-07-08T09:10:11Z' \
	git -C "${DEFAULT_RUN_DIR}/repo" commit -m base --no-gpg-sign >/dev/null 2>&1

followup_blob_oid=$(printf '%s\n' 'base' 'next' | git -C "${DEFAULT_RUN_DIR}/repo" hash-object -w --stdin)
git -C "${DEFAULT_RUN_DIR}/repo" update-index --cacheinfo 100644,"${followup_blob_oid}",story.txt

printf '%s\n' "${DEFAULT_RUN_DIR}/repo" > "${WORKING_DIR_FILE}"
