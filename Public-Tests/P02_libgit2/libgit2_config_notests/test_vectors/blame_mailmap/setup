#!/bin/sh

# © 2026 Massachusetts Institute of Technology
# MIT License

set -e

rm -rf "${DEFAULT_RUN_DIR}/repo"
git init -b main "${DEFAULT_RUN_DIR}/repo" >/dev/null 2>&1
git -C "${DEFAULT_RUN_DIR}/repo" config gc.auto 0
git -C "${DEFAULT_RUN_DIR}/repo" config maintenance.auto false

cat > "${DEFAULT_RUN_DIR}/repo/.mailmap" <<'EOF'
Tester <test@example.com> Mapped <mapped@example.com>
EOF

printf '%s\n' 'line1' 'line2' > "${DEFAULT_RUN_DIR}/repo/file.txt"
git -C "${DEFAULT_RUN_DIR}/repo" add file.txt >/dev/null 2>&1

GIT_AUTHOR_NAME='Tester' \
GIT_AUTHOR_EMAIL='test@example.com' \
GIT_COMMITTER_NAME='Tester' \
GIT_COMMITTER_EMAIL='test@example.com' \
GIT_AUTHOR_DATE='2024-05-01T00:00:00Z' \
GIT_COMMITTER_DATE='2024-05-01T00:00:00Z' \
	git -C "${DEFAULT_RUN_DIR}/repo" commit -m init --no-gpg-sign >/dev/null 2>&1

printf '%s\n' 'line1' 'line2-changed' > "${DEFAULT_RUN_DIR}/repo/file.txt"
git -C "${DEFAULT_RUN_DIR}/repo" add file.txt >/dev/null 2>&1

GIT_AUTHOR_NAME='Tester2' \
GIT_AUTHOR_EMAIL='test@example.com' \
GIT_COMMITTER_NAME='Tester2' \
GIT_COMMITTER_EMAIL='test@example.com' \
GIT_AUTHOR_DATE='2024-05-02T00:00:00Z' \
GIT_COMMITTER_DATE='2024-05-02T00:00:00Z' \
	git -C "${DEFAULT_RUN_DIR}/repo" commit -m change --no-gpg-sign >/dev/null 2>&1

printf '%s\n' "${DEFAULT_RUN_DIR}/repo" > "${WORKING_DIR_FILE}"
