#!/bin/sh

# © 2026 Massachusetts Institute of Technology
# MIT License

set -e

rm -rf "${DEFAULT_RUN_DIR}/repo"
git init -b main "${DEFAULT_RUN_DIR}/repo" >/dev/null 2>&1
git -C "${DEFAULT_RUN_DIR}/repo" config gc.auto 0
git -C "${DEFAULT_RUN_DIR}/repo" config maintenance.auto false

printf '%s\n' 'base' > "${DEFAULT_RUN_DIR}/repo/tracked.txt"
printf '%s\n' 'keep' > "${DEFAULT_RUN_DIR}/repo/other.txt"
git -C "${DEFAULT_RUN_DIR}/repo" add tracked.txt other.txt >/dev/null 2>&1
GIT_AUTHOR_NAME='Iris Pike' \
GIT_AUTHOR_EMAIL='iris@pike.io' \
GIT_COMMITTER_NAME='Iris Pike' \
GIT_COMMITTER_EMAIL='iris@pike.io' \
GIT_AUTHOR_DATE='2024-03-02T08:30:00Z' \
GIT_COMMITTER_DATE='2024-03-02T08:30:00Z' \
	git -C "${DEFAULT_RUN_DIR}/repo" commit -m 'seed files' --no-gpg-sign >/dev/null 2>&1

printf '%s\n' 'base' 'changed' > "${DEFAULT_RUN_DIR}/repo/tracked.txt"
printf '%s\n' 'new' > "${DEFAULT_RUN_DIR}/repo/other.txt"
git -C "${DEFAULT_RUN_DIR}/repo" add other.txt >/dev/null 2>&1

printf '%s\n' "${DEFAULT_RUN_DIR}/repo" > "${WORKING_DIR_FILE}"
