#!/bin/sh

# © 2026 Massachusetts Institute of Technology
# MIT License

set -e

rm -rf "${DEFAULT_RUN_DIR}/repo"
git init -b main "${DEFAULT_RUN_DIR}/repo" >/dev/null 2>&1
git -C "${DEFAULT_RUN_DIR}/repo" config gc.auto 0
git -C "${DEFAULT_RUN_DIR}/repo" config maintenance.auto false

printf '%s\n' 'main' > "${DEFAULT_RUN_DIR}/repo/story.txt"
git -C "${DEFAULT_RUN_DIR}/repo" add story.txt >/dev/null 2>&1

GIT_AUTHOR_NAME='Jules Mercer' \
GIT_AUTHOR_EMAIL='jules@solace.co' \
GIT_COMMITTER_NAME='Jules Mercer' \
GIT_COMMITTER_EMAIL='jules@solace.co' \
GIT_AUTHOR_DATE='2024-01-08T17:03:41Z' \
GIT_COMMITTER_DATE='2024-01-08T17:03:41Z' \
	git -C "${DEFAULT_RUN_DIR}/repo" commit -m base --no-gpg-sign >/dev/null 2>&1

git -C "${DEFAULT_RUN_DIR}/repo" checkout -b side >/dev/null 2>&1
printf '%s\n' 'side' > "${DEFAULT_RUN_DIR}/repo/story.txt"
git -C "${DEFAULT_RUN_DIR}/repo" add story.txt >/dev/null 2>&1

GIT_AUTHOR_NAME='Ivo Hart' \
GIT_AUTHOR_EMAIL='ivo@harbor.net' \
GIT_COMMITTER_NAME='Ivo Hart' \
GIT_COMMITTER_EMAIL='ivo@harbor.net' \
GIT_AUTHOR_DATE='2025-09-23T12:58:27Z' \
GIT_COMMITTER_DATE='2025-09-23T12:58:27Z' \
	git -C "${DEFAULT_RUN_DIR}/repo" commit -m side --no-gpg-sign >/dev/null 2>&1

git -C "${DEFAULT_RUN_DIR}/repo" checkout main >/dev/null 2>&1
printf '%s\n' 'dirty' > "${DEFAULT_RUN_DIR}/repo/story.txt"

printf '%s\n' "${DEFAULT_RUN_DIR}/repo" > "${WORKING_DIR_FILE}"
